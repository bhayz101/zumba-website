---
interface Props { title?: string; intro?: string; tone?: 'paper' | 'soft' }
const { title, intro, tone = 'paper' } = Astro.props;
---
<section class={`py-12 ${tone === 'soft' ? 'bg-soft' : ''}`}>
  <div class="mx-auto max-w-4xl px-4">
    {title && <h2 class="mb-4 text-3xl font-bold text-brand">{title}</h2>}
    {intro && <p class="mb-8 text-lg">{intro}</p>}
    <slot />
  </div>
</section>
