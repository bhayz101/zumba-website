---
interface Props { caption: string; head: [string, string]; rows: [string, string][] }
const { caption, head, rows } = Astro.props;
---
<div class="overflow-x-auto">
  <table class="w-full border-collapse text-left">
    <caption class="mb-2 text-left text-xl font-bold">{caption}</caption>
    <thead><tr>{head.map((h) => <th class="border-b-2 border-brand px-3 py-2">{h}</th>)}</tr></thead>
    <tbody>{rows.map((r) => <tr class="odd:bg-soft">{r.map((c) => <td class="px-3 py-3">{c}</td>)}</tr>)}</tbody>
  </table>
</div>
