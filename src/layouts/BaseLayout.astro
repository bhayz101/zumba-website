---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { cleanPath, localizedPath } from '../lib/paths.mjs';
import { getContent, type Lang } from '../lib/i18n';
interface Props { title: string; description?: string; lang: Lang }
const { title, lang, description } = Astro.props;
const ui = getContent(lang, 'ui');
const here = cleanPath(Astro.url.pathname);
const urlFor = (l: Lang) => new URL(localizedPath(l, here), Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description ?? ui.defaultDescription} />
    <link rel="canonical" href={urlFor(lang)} />
    <link rel="alternate" hreflang="en" href={urlFor('en')} />
    <link rel="alternate" hreflang="fr" href={urlFor('fr')} />
    <link rel="alternate" hreflang="x-default" href={urlFor('en')} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:p-3 focus:text-brand">{ui.skip}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
