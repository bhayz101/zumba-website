---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { getContent, type Lang } from '../lib/i18n';
import { localizedPath } from '../lib/paths.mjs';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = getContent(lang, 'ui');
const c = getContent(lang, 'about');
---
<BaseLayout lang={lang} title={ui.titles.about} description={c.hero.text}>
  <Hero title={c.hero.title} text={c.hero.text} />
  {c.sections.map((s, i) => (
    <Section tone={i % 2 === 0 ? 'paper' : 'soft'} title={s.title}>
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div class={i % 2 === 1 ? 'md:order-2' : ''}><p>{s.text}</p>{s.button && <div class="mt-6"><Button href={localizedPath(lang, s.button.href)}>{s.button.label}</Button></div>}</div>
        <img src={s.image} alt={s.alt} loading="lazy" class="aspect-[4/3] w-full rounded-2xl object-cover" />
      </div>
    </Section>
  ))}
  <Section>
    <figure class="rounded-2xl bg-soft p-8">
      <blockquote class="text-xl italic">{c.quote.text}</blockquote>
      <figcaption class="mt-3 font-bold text-brand">{c.quote.author}</figcaption>
    </figure>
  </Section>
</BaseLayout>
